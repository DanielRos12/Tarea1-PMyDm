<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/tvLogoFit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_logo_fit"
            android:textColor="@color/fit_green"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogoTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_logo_track"
            android:textColor="@color/fit_text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/welcome_slogan"
            android:textColor="@color/fit_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/welcome_description"
            android:textColor="@color/fit_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_create_account" />

        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_login" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/welcome_tagline"
            android:textColor="@color/fit_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
